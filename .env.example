# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Storage
SUPABASE_HAZARD_PHOTOS_BUCKET=hazard-photos

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=change-this-token
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_EHS_ALERT_NUMBERS=60123456789,60198765432

# WhatsApp templates for business-initiated messages
WHATSAPP_DEFAULT_TEMPLATE_LANGUAGE=en_US
WHATSAPP_NOTIFICATION_TEMPLATE_NAME=care_hazard_update

# API protection for cron/test send endpoints in production
CRON_SECRET=change-this-long-random-secret

# AI provider, optional. App falls back safely if missing.
OPENAI_API_KEY=

# App
NEXT_PUBLIC_APP_NAME=CARE Hazard Line
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
